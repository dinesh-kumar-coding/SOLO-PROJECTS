# Normalise line endings so files don't show as modified just because of CRLF/LF.
# Everything is stored as LF in the repo; Git checks out whatever your OS prefers.
* text=auto eol=lf

# Explicit text types
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf

# Binary — never touch these
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.avif   binary
*.webp   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# Keep GitHub's language stats focused on my own code
*.ttf    linguist-vendored
